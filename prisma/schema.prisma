// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url      = env("POSTGRES_PRISMA_URL")
}

enum UserRole {
  ADMIN
  BUSINESS
  CUSTOMER
  WORKER
  CORPORATE
}

enum BusinessType {
  SERVICES
  PRODUCTS
  MIXED
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum GuaranteeType {
  DEPOSIT
  VERIFICATION
  INSURANCE_PER_SERVICE
  REGISTERED_ASSET
  COMBINED
}

enum BranchStatus {
  ACTIVE
  PAUSED
}

enum ServiceStatus {
  ACTIVE
  PAUSED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

enum OrderType {
  SERVICE
  PRODUCT
}

enum OrderStatus {
  PENDING
  PAID
  IN_PROGRESS
  SHIPPING
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentMethod {
  CARD
  TRANSFER
  PAYMENT_LINK
}

enum PaymentStatus {
  PENDING
  IN_ESCROW
  REFUNDING
  RELEASING
  RELEASED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum WithdrawalStatus {
  REQUESTED
  PROCESSING
  APPROVED
  REJECTED
  FAILED
  CANCELED
}

enum PaymentLinkStatus {
  CREATING
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum InvoiceStatus {
  PAID
  OPEN
  VOID
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum DisputeUrgency {
  NORMAL
  URGENT
}

enum DisputeResolution {
  PARTIAL_REFUND
  FULL_REFUND
  RELEASE_PAYMENT
  MORE_EVIDENCE
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  // quote.withdraw (M5-W1). @@unique([requestId, businessId]) keeps one row per
  // pair: re-submitting a WITHDRAWN quote (quote.submit) reopens that same row
  // as PENDING with the new terms (supersedes MA-16; see quote-business.ts).
  WITHDRAWN
}

enum RequestStatus {
  OPEN
  QUOTED
  ACCEPTED
  CANCELLED
  EXPIRED
}

enum WorkerAvailability {
  AVAILABLE
  ON_SERVICE
  OFF
}

enum InvitationStatus {
  PENDING
  ACCEPTED
}

enum LoyaltyBonusStatus {
  PENDING
  PAID
  CANCELLED
}

enum LoyaltyPayoutMethod {
  VOUCHER
  TRANSFER
}

enum DocumentType {
  ID_DOCUMENT
  ADDRESS_PROOF
  INSURANCE_POLICY
  DEPOSIT_RECEIPT
  ASSET_TITLE
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdminAuditAction {
  DISPUTE_EVIDENCE_REQUESTED
  CAMPAIGN_SENT
  BUSINESS_APPROVED
  BUSINESS_REJECTED
  BUSINESS_SUSPENDED
  BUSINESS_REACTIVATED
  DISPUTE_MORE_EVIDENCE
  DISPUTE_RESOLVED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  SETTINGS_UPDATED
  LOYALTY_BONUS_PAID
  LOYALTY_BONUS_CANCELLED
  BUSINESS_REVIEW_REOPENED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  USER_SUSPENDED
  USER_REACTIVATED
  IMPERSONATION_STARTED
  IMPERSONATION_ENDED
}

enum AdminAuditTarget {
  CAMPAIGN
  BUSINESS
  DISPUTE
  WITHDRAWAL
  PLATFORM_SETTINGS
  LOYALTY_BONUS
  BUSINESS_DOCUMENT
  USER
}

// W13 manual broadcast audience ("Campañas y anuncios").
enum CampaignAudience {
  ALL
  CUSTOMERS
  BUSINESSES
  WORKERS
}

enum PushPlatform {
  IOS
  ANDROID
}

enum MessageType {
  TEXT
  IMAGE
  LOCATION
}

enum OrderEventType {
  ACCEPTED
  ESCROW_HELD
  EN_ROUTE
  ARRIVED
  RECORDING_STARTED
  RECORDING_STOPPED
  WORK_DONE
  CONFIRMATION_REQUESTED
  CONFIRMED
  AUTO_RELEASED
  // Business-side lifecycle actions from the web dashboard (order.cancel /
  // order.assignWorker). The cancel reason lives in OrderEvent.note.
  CANCELLED
  WORKER_ASSIGNED
  // Customer-side lifecycle (workstream D): rework sends a WORK_DONE order
  // back to the technician; DISPUTE_OPENED freezes the escrow.
  REWORK_REQUESTED
  DISPUTE_OPENED
}

enum AiUrgency {
  LOW
  MEDIUM
  HIGH
}

// Necessary for Next auth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

// Web session registry (single active session per user). The NextAuth cookie
// is still an encrypted JWT; it carries a random `sid` whose SHA-256 is stored
// in `sessionToken`, and every server-side `auth()` checks this row. Rows are
// soft-revoked (`revokedAt`), never deleted, so the trail survives. Mobile
// Bearer tokens are not tracked here (they revoke via `sessionsValidFrom`).
model Session {
  id                     String                   @id @default(cuid())
  sessionToken           String                   @unique
  userId                 String
  expires                DateTime
  // Random per-browser id from the httpOnly device cookie; lets a re-login on
  // the same computer replace its own session without the conflict prompt.
  deviceId               String?
  userAgent              String?
  initialIp              String?
  lastIp                 String?
  lastSeenAt             DateTime                 @default(now())
  revokedAt              DateTime?
  revocationReason       SessionRevocationReason?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @default(now()) @updatedAt
  user                   User                     @relation("SessionOwner", fields: [userId], references: [id], onDelete: Cascade)
  // Admin impersonation (read-only): while set and not expired, every server
  // `auth()` of this ADMIN session resolves to the impersonated BUSINESS or
  // CORPORATE owner. Cleared on exit, on expiry and when the target vanishes.
  impersonatedUserId     String?
  impersonatedUser       User?                    @relation("SessionImpersonation", fields: [impersonatedUserId], references: [id], onDelete: SetNull)
  impersonationExpiresAt DateTime?

  @@index([userId, revokedAt, expires])
  @@index([impersonatedUserId])
}

enum SessionRevocationReason {
  SIGNED_OUT
  REPLACED_BY_NEW_LOGIN
  EXPIRED
  CREDENTIALS_ROTATED
  SUSPENDED
}

model User {
  id                           String                       @id @default(cuid())
  name                         String?
  email                        String?                      @unique
  emailVerified                DateTime?
  image                        String?
  role                         UserRole                     @default(CUSTOMER)
  // Preferred UI language (es | en). Zod validates it at registration;
  // consumed by mobile emails and localized push (M7-W1).
  locale                       String                       @default("es")
  passwordHash                 String?
  sessionsValidFrom            DateTime                     @default(now())
  // Row lock only: bumped inside the session transaction to serialize
  // concurrent logins of the same user (single active web session).
  sessionLockVersion           Int                          @default(0)
  // Platform moderation (W10): a suspended CUSTOMER/WORKER user cannot sign
  // in and every live session is revoked through `sessionsValidFrom`.
  suspendedAt                  DateTime?
  suspensionReason             String?
  accounts                     Account[]
  sessions                     Session[]                    @relation("SessionOwner")
  impersonationSessions        Session[]                    @relation("SessionImpersonation")
  business                     Business?
  workerProfile                Worker?
  orders                       Order[]
  reviews                      Review[]
  serviceRequests              ServiceRequest[]
  reviewedDocuments            BusinessDocument[]
  passwordResetTokens          PasswordResetToken[]
  adminAuditLogs               AdminAuditLog[]
  corporateAccount             CorporateAccount?            @relation("CorporateOwner")
  managedCorporateAccounts     CorporateAccount[]           @relation("CorporateAccountManager")
  reviewedCorporateTierChanges CorporateTierChangeRequest[] @relation("CorporateTierReviewer")
  pushTokens                   PushToken[]
  campaignsSent                Campaign[]                   @relation("CampaignSender")
  customerProfile              CustomerProfile?
  addresses                    Address[]
  messages                     Message[]
  orderEvents                  OrderEvent[]                 @relation("OrderEventActor")
  requestDiagnoses             RequestDiagnosis[]
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Business {
  id                  String             @id @default(cuid())
  name                String
  type                BusinessType
  status              BusinessStatus     @default(PENDING)
  guaranteeType       GuaranteeType
  guaranteeNotes      String?
  statusReason        String?
  ownerId             String             @unique
  owner               User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  stripeAccountId     String?            @unique
  // Stripe Billing customer (F4). Connect account and Billing customer are
  // different Stripe objects and must never be confused.
  stripeCustomerId    String?            @unique
  chargesEnabled      Boolean            @default(false)
  payoutsEnabled      Boolean            @default(false)
  // Rating denormalized from Review (via Review.order.businessId). Written
  // ONLY by recalculateBusinessRating() or the seed; null = no reviews yet.
  ratingAvg           Float?
  ratingCount         Int                @default(0)
  // Dashboard notifications bell: feed items newer than this are unread.
  // null = never opened (everything in the feed counts as unread).
  notificationsSeenAt DateTime?
  branches            Branch[]
  workers             Worker[]
  services            Service[]
  products            Product[]
  orders              Order[]
  payments            Payment[]
  paymentLinks        PaymentLink[]
  withdrawals         Withdrawal[]
  subscription        Subscription?
  disputes            Dispute[]
  quotes              Quote[]
  documents           BusinessDocument[]
  loyaltyBonuses      LoyaltyBonus[]
  conversations       Conversation[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([status])
  @@index([status, ratingAvg])
}

model Branch {
  id               String         @id @default(cuid())
  name             String
  address          String
  managerName      String?
  // Geo added by M2-W3: notifyNearbyBusinesses / M5-W1 radar need branch
  // coordinates for the Haversine radius match. Nullable so existing rows
  // keep working until each branch is geocoded.
  latitude         Float?
  longitude        Float?
  coverageRadiusKm Int            @default(10)
  status           BranchStatus   @default(ACTIVE)
  businessId       String
  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders           Order[]
  quotes           Quote[]
  workers          Worker[]
  productStocks    ProductStock[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([businessId])
}

model Worker {
  id                  String             @id @default(cuid())
  userId              String?            @unique
  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName            String
  businessId          String
  business            Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId            String?
  branch              Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  specialty           String?
  availability        WorkerAvailability @default(AVAILABLE)
  ratingAvg           Float?
  invitedEmail        String?
  invitationStatus    InvitationStatus   @default(ACCEPTED)
  // Invitation acceptance link (workstream D): only the SHA-256 of the
  // single-use token is stored; cleared once the worker accepts.
  invitationTokenHash String?            @unique
  invitationExpiresAt DateTime?
  // Last known position for C6 tracking (written by tracking.updateLocation,
  // M4-W2, throttled to 15 s).
  lastLatitude        Float?
  lastLongitude       Float?
  locationUpdatedAt   DateTime?
  services            Service[]
  quotes              Quote[]
  // Orders assigned to the technician (MA-01).
  assignedOrders      Order[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([businessId])
  @@index([branchId])
  @@index([businessId, availability])
}

model Service {
  id                 String        @id @default(cuid())
  name               String
  category           String
  basePriceCents     Int
  durationMinutes    Int
  durationMaxMinutes Int?
  status             ServiceStatus @default(ACTIVE)
  businessId         String
  business           Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workers            Worker[]
  orders             Order[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([businessId, status])
  @@index([businessId, category])
}

model Product {
  id             String          @id @default(cuid())
  name           String
  sku            String
  category       String
  priceCents     Int
  // Public catalog image URL (C1/C3 design). Public catalog: does not use the
  // signed media pathname flow (M0-W3).
  imageUrl       String?
  status         ProductStatus   @default(DRAFT)
  businessId     String
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders         Order[]
  stocks         ProductStock[]
  orderMaterials OrderMaterial[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([businessId, sku])
  @@index([businessId, status])
}

model ProductStock {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([productId, branchId])
  @@index([branchId])
}

// A service request is separate from an Order: accepting one Quote creates an Order,
// so every Order continues to represent work with a defined business and price.
model ServiceRequest {
  id                  String             @id @default(cuid())
  customerId          String
  customer            User               @relation(fields: [customerId], references: [id])
  title               String
  description         String?
  category            String
  photoUrls           String[]
  aiConfidencePct     Int?
  aiDiagnosis         String?
  aiMinPriceCents     Int?
  aiMaxPriceCents     Int?
  addressLine         String?
  latitude            Float?
  longitude           Float?
  // AI diagnosis urgency (M2-W2 computed it and discarded it).
  aiUrgency           AiUrgency?
  // Set when the AI confidence falls below PlatformSettings.aiConfidenceThresholdPct
  // and aiHumanReviewBelowThreshold is on: the request waits for a human look.
  needsHumanReview    Boolean            @default(false)
  // Colonia copied from Address.neighborhood at request creation (MA-13).
  // It is the ONLY textual piece of the address a business sees before its
  // quote is accepted (radar privacy gating, M5-W1).
  neighborhood        String?
  status              RequestStatus      @default(OPEN)
  expiresAt           DateTime?
  // Suggestions frozen at diagnosis time (workstream D). Plain ids without FK:
  // a deleted catalog row simply stops being suggested.
  suggestedServiceId  String?
  suggestedProductId  String?
  // Corporate consumer (F7): requests created from a corporate location carry
  // the account/location so the accepted quote's Order inherits them.
  corporateAccountId  String?
  corporateAccount    CorporateAccount?  @relation(fields: [corporateAccountId], references: [id], onDelete: SetNull)
  corporateLocationId String?
  corporateLocation   CorporateLocation? @relation(fields: [corporateLocationId], references: [id], onDelete: SetNull)
  quotes              Quote[]
  conversations       Conversation[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([customerId])
  @@index([status, createdAt])
  @@index([category])
  @@index([corporateAccountId, createdAt])
  @@index([corporateLocationId])
}

// Standalone AI diagnosis (workstream D, C2→C3): `request.diagnose` stores the
// result so `request.create` can reuse it by id instead of re-running the
// model. Single use: `consumedAt` is set when a request is created from it.
model RequestDiagnosis {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaPathnames     String[]
  description        String?
  diagnosis          String
  confidencePct      Int
  category           String
  urgency            AiUrgency
  minPriceCents      Int
  maxPriceCents      Int
  suggestedServiceId String?
  suggestedProductId String?
  consumedAt         DateTime?
  expiresAt          DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId, createdAt])
}

model Quote {
  id           String         @id @default(cuid())
  requestId    String
  request      ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  businessId   String
  business     Business       @relation(fields: [businessId], references: [id])
  branchId     String?
  branch       Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  workerId     String?
  worker       Worker?        @relation(fields: [workerId], references: [id], onDelete: SetNull)
  amountCents  Int
  message      String?
  scheduledFor DateTime?
  status       QuoteStatus    @default(PENDING)
  order        Order?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([requestId, businessId])
  @@index([businessId, status])
  @@index([requestId])
  @@index([branchId])
  @@index([workerId])
}

model Order {
  id                     String             @id @default(cuid())
  folio                  Int                @unique @default(autoincrement())
  type                   OrderType
  title                  String
  status                 OrderStatus        @default(PENDING)
  amountCents            Int
  customerId             String
  customer               User               @relation(fields: [customerId], references: [id])
  businessId             String
  business               Business           @relation(fields: [businessId], references: [id])
  branchId               String?
  branch                 Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  serviceId              String?
  service                Service?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  productId              String?
  product                Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  quoteId                String?            @unique
  quote                  Quote?             @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  corporateAccountId     String?
  corporateAccount       CorporateAccount?  @relation(fields: [corporateAccountId], references: [id], onDelete: SetNull)
  // Attention location within the corporate account. The order service must
  // validate that this location belongs to corporateAccountId: the database
  // cannot express equality between two optional FKs.
  corporateLocationId    String?
  corporateLocation      CorporateLocation? @relation(fields: [corporateLocationId], references: [id], onDelete: SetNull)
  // Assigned technician (MA-01). Written by quote.accept (M3-W1) copying it
  // from Quote.workerId in the same transaction. PRODUCT orders: null (no
  // worker mode). Nullable: historical and PRODUCT orders have no worker.
  workerId               String?
  worker                 Worker?            @relation(fields: [workerId], references: [id], onDelete: SetNull)
  // Delivery snapshot (MA-06). For PRODUCT it is copied by createProductIntent
  // (M3-W2) from the input Address (snapshot, not FK: the Address is editable
  // and deletable). For SERVICE it stays null: geo/address derive from
  // quote.request (ServiceRequest.addressLine/latitude/longitude).
  deliveryAddressLine    String?
  deliveryLatitude       Float?
  deliveryLongitude      Float?
  quantity               Int                @default(1)
  recordingUrl           String?
  recordingDurationSec   Int?
  recordingComplete      Boolean            @default(false)
  // Idempotency for the rating-reminder cron: at most one reminder per order.
  ratingReminderSentAt   DateTime?
  beforeUrls             String[]
  afterUrls              String[]
  workNotes              String?
  // Worker justification when the recording is missing or incomplete at
  // finish (RECORDING_JUSTIFICATION_REQUIRED, D6: disputes still favour the
  // customer when the recording is incomplete).
  recordingJustification String?
  materials              OrderMaterial[]
  recordingSegments      RecordingSegment[]
  payment                Payment?
  dispute                Dispute?
  review                 Review?
  conversation           Conversation?
  events                 OrderEvent[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([workerId, status])
  @@index([businessId, status])
  @@index([businessId, branchId])
  @@index([customerId])
  @@index([branchId])
  @@index([serviceId])
  @@index([productId])
  @@index([corporateAccountId])
  @@index([corporateLocationId])
}

// Materials are rows instead of JSON so callers get typed selects and an optional Product FK.
model OrderMaterial {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name           String
  quantity       Int      @default(1)
  unitPriceCents Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
}

model RecordingSegment {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  startedAt   DateTime
  endedAt     DateTime?
  startLat    Float
  startLng    Float
  endLat      Float?
  endLng      Float?
  pathname    String?
  uploadedAt  DateTime?
  interrupted Boolean   @default(false)

  @@index([orderId])
}

// B2B corporate domain (F7). Corporate accounts consume services (unlike
// Business, which provides them), pay a monthly membership and get a
// preferential commission on the orders they generate.

enum CorporateTier {
  BASIC
  STANDARD
  ENTERPRISE
  CUSTOM
}

enum CorporateStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum CorporateTierChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

// Effective terms (commissionPct, monthlyFeeCents, maxLocations) live on the
// account, not only in CorporateTierConfig: CUSTOM tiers are negotiated per
// account and may deviate from the catalog.
model CorporateAccount {
  id                 String                       @id @default(cuid())
  name               String
  taxId              String? // RFC for consolidated invoicing
  ownerId            String                       @unique
  owner              User                         @relation("CorporateOwner", fields: [ownerId], references: [id])
  tier               CorporateTier                @default(BASIC)
  status             CorporateStatus              @default(PENDING)
  commissionPct      Int // 10 / 8 / 5 / negotiated (< 5 in CUSTOM)
  monthlyFeeCents    Int // 150000 / 350000 / 750000 / negotiated
  maxLocations       Int? // 3 / 15 / 50 / null = unlimited
  accountManagerId   String? // account executive (tier >= STANDARD)
  accountManager     User?                        @relation("CorporateAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  stripeCustomerId   String?                      @unique
  statusReason       String?
  locations          CorporateLocation[]
  serviceRequests    ServiceRequest[]
  membership         CorporateMembership?
  tierChangeRequests CorporateTierChangeRequest[]
  invoices           CorporateInvoice[]
  orders             Order[]
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@index([status, tier])
  @@index([accountManagerId])
}

model CorporateLocation {
  id                 String           @id @default(cuid())
  corporateAccountId String
  corporateAccount   CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)
  name               String
  addressLine        String
  city               String
  contactName        String?
  contactPhone       String?
  // CorporateLocation geo (workstream D): requests raised from a location
  // copy these so the radar (Haversine) can match nearby providers. Null
  // until geocoded; such requests are not visible on the radar.
  latitude           Float?
  longitude          Float?
  isActive           Boolean          @default(true)
  orders             Order[]
  serviceRequests    ServiceRequest[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([corporateAccountId, isActive])
}

model CorporateMembership {
  id                   String             @id @default(cuid())
  corporateAccountId   String             @unique
  corporateAccount     CorporateAccount   @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus
  renewsAt             DateTime?
  // Epoch of the last Stripe event applied, so F7-07 can discard out-of-order
  // webhook deliveries.
  stripeUpdatedAt      DateTime?
  invoices             CorporateInvoice[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

// Tier catalog (seeded, same pattern as Plan): values live in the database so
// the admin can negotiate CUSTOM without a deploy. The CUSTOM row keeps fee,
// limit, commission and Stripe price null: terms are negotiated per account.
model CorporateTierConfig {
  id              String        @id @default(cuid())
  tier            CorporateTier @unique
  monthlyFeeCents Int?
  maxLocations    Int?
  commissionPct   Int?
  stripePriceId   String?       @unique
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([isActive])
}

// pendingKey holds corporateAccountId while status is PENDING and is set to
// null on approval/rejection, so the unique constraint guarantees a single
// pending request per account even under concurrent requests.
model CorporateTierChangeRequest {
  id                 String                    @id @default(cuid())
  corporateAccountId String
  corporateAccount   CorporateAccount          @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)
  requestedTier      CorporateTier
  notes              String?
  status             CorporateTierChangeStatus @default(PENDING)
  pendingKey         String?                   @unique
  reviewedById       String?
  reviewedBy         User?                     @relation("CorporateTierReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([corporateAccountId, status, createdAt])
  @@index([reviewedById])
}

// Membership invoices synced from Stripe (consolidated corporate billing).
model CorporateInvoice {
  id                    String              @id @default(cuid())
  corporateAccountId    String
  corporateAccount      CorporateAccount    @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)
  corporateMembershipId String
  corporateMembership   CorporateMembership @relation(fields: [corporateMembershipId], references: [id], onDelete: Cascade)
  stripeInvoiceId       String              @unique
  amountCents           Int
  status                InvoiceStatus
  pdfUrl                String?
  issuedAt              DateTime
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([corporateAccountId, issuedAt])
  @@index([corporateMembershipId])
}

// Origin of the effective commission frozen on a Payment (XC-26). The
// provider-plan reference is always frozen alongside it so historical savings
// stay auditable even after plan or corporate-term renegotiations.
enum CommissionSource {
  PROVIDER_PLAN
  CORPORATE_ACCOUNT
}

model Payment {
  id                               String           @id @default(cuid())
  orderId                          String?          @unique
  order                            Order?           @relation(fields: [orderId], references: [id])
  paymentLinkId                    String?          @unique
  paymentLink                      PaymentLink?     @relation(fields: [paymentLinkId], references: [id])
  businessId                       String
  business                         Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  method                           PaymentMethod
  status                           PaymentStatus    @default(PENDING)
  amountCents                      Int
  providerAmountCents              Int
  serviceFeeCentsApplied           Int
  commissionPctApplied             Int
  commissionCents                  Int
  // Reference snapshot frozen at capture (XC-26): the commission the provider
  // plan alone would have charged over the same principal, plus the source of
  // the effective commission. Plan/tier renegotiations never rewrite these.
  providerPlanCommissionPctApplied Int
  providerPlanCommissionCents      Int
  commissionSource                 CommissionSource
  providerRefundedCents            Int              @default(0)
  serviceFeeRefundedCents          Int              @default(0)
  refundedCents                    Int              @default(0)
  stripePaymentIntentId            String?          @unique
  stripeChargeId                   String?          @unique
  stripeTransferId                 String?          @unique
  escrowReleaseAt                  DateTime?
  escrowReleaseAttemptedAt         DateTime?
  releasedAt                       DateTime?
  loyaltyBonus                     LoyaltyBonus?
  createdAt                        DateTime         @default(now())
  updatedAt                        DateTime         @updatedAt

  @@index([status, escrowReleaseAt])
  @@index([status, escrowReleaseAttemptedAt, escrowReleaseAt])
  @@index([businessId, status])
  @@index([businessId, createdAt])
}

model LoyaltyBonus {
  id          String               @id @default(cuid())
  businessId  String
  business    Business             @relation(fields: [businessId], references: [id])
  paymentId   String               @unique
  payment     Payment              @relation(fields: [paymentId], references: [id])
  amountCents Int
  pctApplied  Int
  status      LoyaltyBonusStatus   @default(PENDING)
  method      LoyaltyPayoutMethod?
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([businessId, status])
}

model PaymentLink {
  id                     String            @id @default(cuid())
  businessId             String
  business               Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  concept                String
  amountCents            Int
  serviceFeeCentsApplied Int
  successUrl             String
  status                 PaymentLinkStatus @default(CREATING)
  stripeUrl              String?
  stripePaymentLinkId    String?           @unique
  paidAt                 DateTime?
  payment                Payment?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([businessId])
}

model Withdrawal {
  id                    String           @id @default(cuid())
  businessId            String
  business              Business         @relation(fields: [businessId], references: [id])
  amountCents           Int
  bankName              String
  accountLast4          String
  status                WithdrawalStatus @default(REQUESTED)
  rejectionReason       String?
  payoutStripeAccountId String?
  stripePayoutId        String?          @unique
  resolvedAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([status])
  @@index([businessId])
}

model Plan {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  priceCents    Int
  commissionPct Int
  maxBranches   Int?
  maxWorkers    Int?
  maxProducts   Int?
  stripePriceId String?        @unique
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Subscription {
  id                   String             @id @default(cuid())
  businessId           String             @unique
  business             Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  status               SubscriptionStatus @default(ACTIVE)
  renewsAt             DateTime
  stripeSubscriptionId String?            @unique
  invoices             Invoice[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([planId])
}

model Invoice {
  id              String        @id @default(cuid())
  subscriptionId  String
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amountCents     Int
  status          InvoiceStatus
  stripeInvoiceId String?       @unique
  pdfUrl          String?
  issuedAt        DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([subscriptionId])
}

model Dispute {
  id                            String             @id @default(cuid())
  orderId                       String             @unique
  order                         Order              @relation(fields: [orderId], references: [id])
  businessId                    String
  business                      Business           @relation(fields: [businessId], references: [id])
  title                         String
  urgency                       DisputeUrgency     @default(NORMAL)
  status                        DisputeStatus      @default(OPEN)
  customerArgument              String
  businessArgument              String?
  evidenceUrls                  String[]
  aiSummary                     String?
  aiSummaryGeneratedAt          DateTime?
  // Last "request more evidence" note written by an admin (W11).
  evidenceRequestNote           String?
  evidenceRequestedAt           DateTime?
  resolution                    DisputeResolution?
  resolutionAmountCents         Int?
  // D6 traceability: an incomplete recording resolves in favour of the
  // customer, so any other resolution must record its justification and the
  // recording state observed at resolution time.
  resolutionNotes               String?
  recordingCompleteAtResolution Boolean?
  resolvedAt                    DateTime?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  @@index([status, urgency])
  @@index([businessId])
}

model Review {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

model BusinessDocument {
  id           String         @id @default(cuid())
  businessId   String
  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type         DocumentType
  fileUrl      String
  status       DocumentStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?          @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([businessId, status])
  @@index([reviewedById])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

// Append-only trail of every administrative action that changes an account
// state, moves or records money, or edits a risk variable. It stores ids,
// states and amounts only: never free text, contact data, external URLs or
// provider identifiers.
model AdminAuditLog {
  id         String           @id @default(cuid())
  adminId    String
  admin      User             @relation(fields: [adminId], references: [id])
  action     AdminAuditAction
  targetType AdminAuditTarget
  targetId   String
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([adminId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
}

// Mobile app foundations (M0): push device registry, Stripe customer profile
// and saved addresses for CUSTOMER users.
model PushToken {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expoToken  String       @unique
  platform   PushPlatform
  deviceName String?
  createdAt  DateTime     @default(now())
  lastSeenAt DateTime     @default(now())

  @@index([userId])
}

model CustomerProfile {
  id                     String  @id @default(cuid())
  userId                 String  @unique
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId       String? @unique
  defaultPaymentMethodId String?
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String
  addressLine  String
  // Structured colonia (MA-13). Captured by the mobile address form (new
  // field on the M2 screen; lands with M5-M1, its first consumer). Null →
  // the radar shows only distance/zone.
  neighborhood String?
  latitude     Float
  longitude    Float
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
}

// Messaging (M4-W1) and order timeline (C6). A conversation is attached to an
// Order (post-acceptance chat) or to a ServiceRequest×Business pair
// (pre-order chat of N2).
model Conversation {
  id         String          @id @default(cuid())
  orderId    String?         @unique
  order      Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestId  String?
  request    ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // Business owning the per-request conversation (pre-order chat of N2,
  // audit MA-08). Created by quote.submit (M5-W1); quote.accept (M3-W1)
  // re-links it to the Order by setting orderId. Null on conversations
  // created directly per order (getOrCreateConversation).
  businessId String?
  business   Business?       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages   Message[]
  createdAt  DateTime        @default(now())

  // One conversation per request×business pair (MA-08).
  @@unique([requestId, businessId])
  @@index([requestId])
  @@index([businessId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  type           MessageType
  body           String?
  attachmentUrl  String?
  latitude       Float?
  longitude      Float?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model OrderEvent {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        OrderEventType
  actorUserId String?
  actor       User?          @relation("OrderEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  // Free-text context of the event (e.g. the business cancel reason).
  note        String?
  createdAt   DateTime       @default(now())

  @@index([orderId, createdAt])
  @@index([actorUserId])
}

model AuthAttempt {
  id         String   @id @default(cuid())
  identifier String
  action     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier, action, createdAt])
}

model PlatformSettings {
  id                          Int      @id @default(1)
  aiConfidenceThresholdPct    Int      @default(85)
  aiPriceMarginPct            Int      @default(25)
  aiPricingModel              String   @default("v3.2")
  aiHumanReviewBelowThreshold Boolean  @default(true)
  customerServiceFeeCents     Int      @default(2500)
  loyaltyBonusPct             Int      @default(50)
  escrowAutoReleaseHours      Int      @default(72)
  notifyNewRequestRadiusKm    Int      @default(10)
  notifyPaymentRelease        Boolean  @default(true)
  notifyRatingReminderHours   Int      @default(24)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model Campaign {
  id             String           @id @default(cuid())
  title          String
  body           String
  audience       CampaignAudience
  sentById       String
  sentBy         User             @relation("CampaignSender", fields: [sentById], references: [id])
  sentAt         DateTime         @default(now())
  recipientCount Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([sentAt])
  @@index([sentById])
}
