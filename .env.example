# POSTGRES_PRISMA_URL: PostgreSQL connection string from your database provider.
POSTGRES_PRISMA_URL="postgresql://user:password@localhost:5432/home360"

# APP_URL: Public application origin, without a path or trailing slash.
APP_URL="http://localhost:3000"

# AUTH_SECRET: Generate locally with `npx auth secret`.
AUTH_SECRET=""

# AUTH_GOOGLE_ID: OAuth client ID from Google Cloud Console.
AUTH_GOOGLE_ID=""

# AUTH_GOOGLE_SECRET: OAuth client secret from Google Cloud Console.
AUTH_GOOGLE_SECRET=""

# CRON_SECRET: Shared secret for cron route handlers. Generate with `openssl rand -hex 32`.
CRON_SECRET=""

# STRIPE_SECRET_KEY: Secret API key from Stripe test mode.
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Webhook signing secret from `stripe listen` in test mode.
STRIPE_WEBHOOK_SECRET=""

# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY: Publishable API key from Stripe test mode.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# RESEND_API_KEY: API key from the Resend dashboard.
RESEND_API_KEY=""

# EMAIL_FROM: Verified sender address configured in Resend.
EMAIL_FROM="Home360 <notifications@example.com>"

# SENDDM_API_KEY: API key from the send.dm dashboard.
SENDDM_API_KEY=""

# SMS_FROM: Sender ID or phone number configured in send.dm.
SMS_FROM="Home360"
