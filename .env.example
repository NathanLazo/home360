# Every variable read by src/env.js. Required ones fail the build when missing;
# optional ones degrade the feature they power (noted per line).
# Run with SKIP_ENV_VALIDATION=1 only for Docker/CI builds without secrets.

# --- Core (required) ---------------------------------------------------------

# APP_URL: public origin without path (e.g. https://home360.mx). Used for links, Stripe return URLs and emails.
APP_URL="http://localhost:3000"

# AUTH_SECRET: NextAuth secret (required in production). Generate with `npx auth secret`.
AUTH_SECRET=""

# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: OAuth client from Google Cloud Console.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# POSTGRES_PRISMA_URL: pooled Postgres connection string.
POSTGRES_PRISMA_URL="postgresql://postgres:password@localhost:5432/home360"

# CRON_SECRET: shared secret for /api/cron/* handlers. Generate with `openssl rand -hex 32`.
CRON_SECRET=""

# --- Payments (optional in dev; money flows fail with a stable code without them) ---

# STRIPE_SECRET_KEY: secret API key (test mode in dev).
STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET: signing secret of /api/webhooks/stripe (`stripe listen` in dev).
STRIPE_WEBHOOK_SECRET=""
# STRIPE_CONNECT_WEBHOOK_SECRET: signing secret of /api/webhooks/stripe/connect (connected-account events).
STRIPE_CONNECT_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY: publishable key for Stripe.js.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Product pickup (optional in dev; required in production) ---------------

# PICKUP_CODE_SECRET: HMAC key that derives each PICKUP order's QR code from its id
# (only the SHA-256 of the code is stored). Generate with `openssl rand -hex 32`.
# Rotating it invalidates the codes of orders already marked ready for pickup.
PICKUP_CODE_SECRET=""

# --- AI (optional; without the key the assistant composer and AI diagnosis are disabled) ---

# AI_GATEWAY_API_KEY: Vercel AI Gateway key (diagnosis, dispute summaries, assistant).
AI_GATEWAY_API_KEY=""
# AGENT_MODEL: assistant default model id; must exist in src/lib/agent/agent-models.ts
# (default inclusionai/ling-3.0-flash-sante).
AGENT_MODEL=""

# --- Storage (optional; uploads and evidence fail without it) ----------------

# BLOB_READ_WRITE_TOKEN: Vercel Blob read/write token.
BLOB_READ_WRITE_TOKEN=""

# --- Realtime (optional; without it chat/tracking fall back to polling) ------

PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# --- Email and SMS (optional; email/SMS delivery is skipped without them) ---

# RESEND_API_KEY / EMAIL_FROM: transactional email.
RESEND_API_KEY=""
EMAIL_FROM="HOME360 <no-reply@home360.mx>"
# SENDDM_API_KEY / SMS_FROM: send.dm SMS.
SENDDM_API_KEY=""
SMS_FROM="Home360"
